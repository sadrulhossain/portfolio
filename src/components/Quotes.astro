---
import { quotes } from '../data/quotes.js'
---

{
    quotes.length > 0 && (
        <section class="border-b border-slate-200 bg-slate-900 dark:border-slate-800 dark:bg-slate-950">
            <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
                {quotes.map((item) => (
                    <figure>
                        <blockquote class="text-lg font-medium italic leading-relaxed text-slate-200">
                            &ldquo;{item.quote}&rdquo;
                        </blockquote>
                        <figcaption class="mt-4 text-sm text-slate-400">
                            &mdash; {item.quoter.name}, {item.quoter.affiliation}
                        </figcaption>
                    </figure>
                ))}
            </div>
        </section>
    )
}
