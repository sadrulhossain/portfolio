---
import { Image } from 'astro:assets'
import heroImage from '../assets/hero.png'
import Icon from './Icon.astro'
import { profile } from '../data/profile.js'
import { social_contacts } from '../data/social-contact.js'
import { withBase } from '../lib/base.js'
---

<section id="home" class="relative overflow-hidden border-b border-slate-200 dark:border-slate-800">
    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.07] dark:opacity-[0.09]" aria-hidden="true">
        <defs>
            <pattern id="tech-grid" width="120" height="120" patternUnits="userSpaceOnUse">
                <g fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M10 10 H60 V40 H110" />
                    <path d="M10 70 H40 V110" />
                    <path d="M70 20 V70 H110" />
                    <path d="M20 90 H90 V60" />
                </g>
                <g fill="currentColor">
                    <circle cx="10" cy="10" r="2.5" />
                    <circle cx="60" cy="40" r="2.5" />
                    <circle cx="110" cy="40" r="2.5" />
                    <circle cx="10" cy="70" r="2.5" />
                    <circle cx="40" cy="110" r="2.5" />
                    <circle cx="70" cy="20" r="2.5" />
                    <circle cx="70" cy="70" r="2.5" />
                    <circle cx="110" cy="70" r="2.5" />
                    <circle cx="20" cy="90" r="2.5" />
                    <circle cx="90" cy="90" r="2.5" />
                    <circle cx="90" cy="60" r="2.5" />
                </g>
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#tech-grid)" class="text-teal-700 dark:text-teal-400" />
    </svg>

    <div class="relative mx-auto grid max-w-5xl gap-10 px-4 py-16 sm:px-6 sm:py-24 md:grid-cols-2 md:items-center md:py-32">
        <div class="motion-safe:animate-[fade-in_0.6s_ease-out] rounded-3xl border border-white/60 bg-white/50 p-6 shadow-xl backdrop-blur-md dark:border-white/10 dark:bg-slate-900/40 sm:p-8">
            <p class="text-sm font-semibold uppercase tracking-wider text-teal-700 dark:text-teal-400">Hello, I'm</p>
            <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
                {profile.name}
            </h1>
            <p class="mt-2 text-xl font-medium text-slate-600 dark:text-slate-300">{profile.role}</p>

            <ul class="mt-6 space-y-2 text-slate-600 dark:text-slate-300">
                <li class="flex items-center gap-2">
                    <Icon name="mail" class="h-4 w-4 shrink-0 text-teal-700 dark:text-teal-400" />
                    <a href={`mailto:${profile.email}`} class="hover:text-teal-600 dark:hover:text-teal-400">{profile.email}</a>
                </li>
                <li class="flex items-center gap-2">
                    <Icon name="phone" class="h-4 w-4 shrink-0 text-teal-700 dark:text-teal-400" />
                    <a href={`tel:${profile.phoneHref}`} class="hover:text-teal-600 dark:hover:text-teal-400">{profile.phone}</a>
                </li>
                <li class="flex items-center gap-2">
                    <Icon name="map-pin" class="h-4 w-4 shrink-0 text-teal-700 dark:text-teal-400" />
                    <span>{profile.location}</span>
                </li>
            </ul>

            <div class="mt-8 flex flex-wrap gap-3">
                <a
                    href="#contact"
                    class="inline-flex items-center gap-2 rounded-full bg-teal-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-teal-800"
                >
                    Contact Me
                </a>
                <a
                    href={withBase(profile.cvPath)}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-teal-600 hover:text-teal-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-teal-400 dark:hover:text-teal-400"
                >
                    Download CV
                    <Icon name="download" class="h-4 w-4" />
                </a>
            </div>

            <ul class="mt-8 flex items-center gap-4">
                {
                    social_contacts.map((contact) => (
                        <li>
                            <a
                                href={contact.href}
                                target="_blank"
                                rel="noopener"
                                aria-label={contact.name}
                                class="inline-flex h-9 w-9 items-center justify-center rounded-full text-slate-500 transition-colors hover:bg-slate-100 hover:text-teal-600 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-teal-400"
                            >
                                <Icon name={contact.icon as any} class="h-5 w-5" />
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="motion-safe:animate-[fade-in_0.8s_ease-out] md:justify-self-end">
            <div class="mx-auto aspect-square w-56 overflow-hidden rounded-full border-4 border-teal-600/20 shadow-xl sm:w-72 md:w-80">
                <Image src={heroImage} alt={profile.name} class="h-full w-full object-cover" width={400} height={400} />
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
