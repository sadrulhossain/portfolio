---
import { Image } from 'astro:assets'
import aboutImage from '../assets/about.png'
import SectionHeading from './SectionHeading.astro'
import { profile } from '../data/profile.js'
import { technical_expertise } from '../data/technical-expertise.js'
import { professional_expertise } from '../data/professional-expertise.js'
---

<section id="about" class="border-b border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
        <SectionHeading eyebrow="Get to know me" title="About Me" />

        <div class="grid gap-10 md:grid-cols-2 md:items-start">
            <div class="overflow-hidden rounded-2xl shadow-lg">
                <Image src={aboutImage} alt={`${profile.name} at work`} class="h-full w-full object-cover" width={640} height={640} />
            </div>

            <div>
                <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-300" set:html={profile.summary} />

                <ul class="mt-6 space-y-3">
                    {
                        profile.highlights.map((highlight) => (
                            <li class="text-slate-700 dark:text-slate-300" set:html={highlight} />
                        ))
                    }
                </ul>
            </div>
        </div>

        <div class="mt-12 grid gap-8 sm:grid-cols-2">
            <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                    Technical Expertise
                </h3>
                <ul class="mt-4 flex flex-wrap gap-2">
                    {
                        technical_expertise.map((item) => (
                            <li class="rounded-full bg-white px-3 py-1 text-sm text-slate-700 shadow-sm ring-1 ring-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:ring-slate-700">
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </div>
            <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                    Professional Expertise
                </h3>
                <ul class="mt-4 flex flex-wrap gap-2">
                    {
                        professional_expertise.map((item) => (
                            <li class="rounded-full bg-white px-3 py-1 text-sm text-slate-700 shadow-sm ring-1 ring-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:ring-slate-700">
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
