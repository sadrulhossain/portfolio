---
import SectionHeading from './SectionHeading.astro'
import { technical_skill } from '../data/technical-skill.js'
import { professional_skill } from '../data/professional-skill.js'

const RADIUS = 42
const CIRCUMFERENCE = 2 * Math.PI * RADIUS
---

<section id="skills" class="border-b border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
        <SectionHeading eyebrow="What I bring" title="Technical Skills" />

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {
                technical_skill.map((group) => (
                    <div>
                        <h3 class="font-semibold text-slate-900 dark:text-white">{group.category}</h3>
                        <ul class="mt-4 space-y-3">
                            {group.skills.map((item) => (
                                <li>
                                    <div class="mb-1 flex items-center justify-between text-sm">
                                        <span class="text-slate-700 dark:text-slate-300">{item.skill}</span>
                                        <span class="text-slate-500 dark:text-slate-400">{item.proficiency}%</span>
                                    </div>
                                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
                                        <div
                                            class="h-full rounded-full bg-teal-600 dark:bg-teal-400"
                                            style={`width: ${item.proficiency}%`}
                                        />
                                    </div>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div class="mt-16">
            <SectionHeading eyebrow="How I work" title="Professional Skills" />
            <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
                {
                    professional_skill.map((item) => {
                        const offset = CIRCUMFERENCE * (1 - item.proficiency / 100)
                        return (
                            <div class="flex flex-col items-center text-center">
                                <div class="relative h-24 w-24">
                                    <svg viewBox="0 0 100 100" class="h-24 w-24 -rotate-90">
                                        <circle cx="50" cy="50" r={RADIUS} fill="none" stroke-width="8" class="stroke-slate-200 dark:stroke-slate-800" />
                                        <circle
                                            cx="50"
                                            cy="50"
                                            r={RADIUS}
                                            fill="none"
                                            stroke-width="8"
                                            stroke-linecap="round"
                                            class="stroke-teal-600 dark:stroke-teal-400"
                                            stroke-dasharray={CIRCUMFERENCE}
                                            stroke-dashoffset={offset}
                                        />
                                    </svg>
                                    <span class="absolute inset-0 flex items-center justify-center text-sm font-semibold text-slate-900 dark:text-white">
                                        {item.proficiency}%
                                    </span>
                                </div>
                                <p class="mt-3 text-sm font-medium text-slate-700 dark:text-slate-300">{item.skill}</p>
                            </div>
                        )
                    })
                }
            </div>
        </div>
    </div>
</section>
