---
interface Props {
    eyebrow?: string
    title: string
    center?: boolean
}

const { eyebrow, title, center = false } = Astro.props
---

<div class:list={['mb-10 sm:mb-12', center && 'text-center']}>
    {eyebrow && <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-teal-700 dark:text-teal-400">{eyebrow}</p>}
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">{title}</h2>
    <div class:list={['mt-4 h-1 w-16 rounded-full bg-teal-600 dark:bg-teal-400', center && 'mx-auto']} />
</div>
