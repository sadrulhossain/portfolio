---
import { educations } from '../data/education.js'
---

<div>
    <h3 class="text-xl font-semibold text-slate-900 dark:text-white">Education</h3>
    <ol class="mt-6 space-y-8 border-l border-slate-200 pl-6 dark:border-slate-800">
        {
            educations.map((item) => (
                <li class="relative">
                    <span class="absolute -left-[29px] top-1.5 h-3 w-3 rounded-full border-2 border-teal-600 bg-white dark:border-teal-400 dark:bg-slate-950" />
                    <p class="text-sm font-medium text-teal-600 dark:text-teal-400">{item.tenure}</p>
                    <h4 class="mt-1 font-semibold text-slate-900 dark:text-white">
                        {item.degree} <span class="font-normal text-slate-600 dark:text-slate-300">from {item.uni_board}</span>
                    </h4>
                    <div class="mt-2 text-sm text-slate-600 dark:text-slate-300">
                        {item.faculty && <p set:html={item.faculty} />}
                        {item.department && <p set:html={item.department} />}
                        {item.institute && <p>{item.institute}</p>}
                        {item.division && <p set:html={item.division} />}
                        <p>
                            <b>Result:</b> {item.result.type} <b>{item.result.achieved}</b> out of <b>{item.result.full}</b>
                        </p>
                    </div>
                </li>
            ))
        }
    </ol>
</div>
