---
import SectionHeading from './SectionHeading.astro'
import { educations } from '../data/education.js'
---

<section id="education" class="border-b border-slate-200 dark:border-slate-800">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
        <SectionHeading eyebrow="Academic background" title="Education" />

        <div class="grid gap-6 sm:grid-cols-2">
            {
                educations.map((item) => (
                    <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-teal-100 dark:bg-slate-900 dark:ring-slate-800">
                        <p class="text-sm font-medium text-teal-700 dark:text-teal-400">{item.tenure}</p>
                        <h3 class="mt-1 font-semibold text-slate-900 dark:text-white">
                            {item.degree} <span class="font-normal text-slate-600 dark:text-slate-300">from {item.uni_board}</span>
                        </h3>
                        <div class="mt-3 space-y-1 text-sm text-slate-600 dark:text-slate-300">
                            {item.faculty && <p set:html={item.faculty} />}
                            {item.department && <p set:html={item.department} />}
                            {item.institute && <p>{item.institute}</p>}
                            {item.division && <p set:html={item.division} />}
                            <p>
                                <b>Result:</b> {item.result.type} <b>{item.result.achieved}</b> out of <b>{item.result.full}</b>
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
