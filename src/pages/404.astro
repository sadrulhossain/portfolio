---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../lib/base.js'
---

<BaseLayout title="Page Not Found" description="The page you are looking for does not exist.">
    <div class="mx-auto flex max-w-5xl flex-col items-center px-4 py-24 text-center sm:px-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-teal-600 dark:text-teal-400">404</p>
        <h1 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl dark:text-white">Page not found</h1>
        <p class="mt-4 text-slate-600 dark:text-slate-300">The page you're looking for doesn't exist or has moved.</p>
        <a
            href={withBase('/')}
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-teal-700"
        >
            Back to home
        </a>
    </div>
</BaseLayout>
